# Copy this file to .env and edit. Never commit your real .env.
# DMLand creates .env for you on first run and fills the two values below with random ones.

# Password for the dashboard (any username works). Pick something long if you expose it beyond your own machine.
# DASHBOARD_PASSWORD=              # generated on first start

# TOKEN_ENCRYPTION_KEY=             # generated on first start. Back up separately from SQLite.
# TOKEN_ENCRYPTION_KEY_FILE=        # read the key from a file instead (Docker secret)
# ENV_FILE=                         # where .env is read and written (default: repository root)
# HOST=127.0.0.1                    # keep the HTTP dashboard private
# ALLOWED_HOSTS=                    # extra host names/IPs used to open the dashboard (e.g. 10.0.0.5,myserver.ts.net)

# Optional. Polling works with webhooks disabled.
# WEBHOOKS_ENABLED=off
WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# --- Optional tuning (defaults shown) ---
# PORT=3000
# POLL_SECONDS=60          # how often comments are read
# DM_POLL_SECONDS=30       # how often DM replies are read (email capture)
# STATS_MINUTES=30         # how often account and reel insights are collected
# HOURLY_CAP=60            # private reply attempts per hour per account (maximum configurable: 200)
# INBOX_ANALYTICS=off       # opt in to reading conversations for follow-up analytics
# GRAPH_VERSION=v27.0      # Meta Graph API version
# LOG_LEVEL=info          # container logs: debug | info | warn | error | off
# POLL=off                 # set to "off" to run the dashboard without reading comments
